# ── Database (Neon Postgres) ──────────────────────────────────────────
# Owner role — used ONLY by packages/db scripts (migrations, seeds, checks)
DATABASE_URL=postgresql://neondb_owner:...@ep-xxx-pooler.../neondb?sslmode=require
# Direct (non-pooled) endpoint for migrations
DATABASE_URL_DIRECT=postgresql://neondb_owner:...@ep-xxx.../neondb?sslmode=require
# app_user role — used by apps/web
DATABASE_URL_APP=postgresql://app_user:...@ep-xxx-pooler.../neondb?sslmode=require
# ai_agent role — used by apps/mcp-server
DATABASE_URL_AI=postgresql://ai_agent:...@ep-xxx-pooler.../neondb?sslmode=require

# ── Central AI API Server (licensed LLM gateway) ──────────────────────
AI_API_SERVER_URL=http://115.187.22.224:6601
LICENSE_KEY=
# Fallback models (resolution order: app setting > license > env > fallback)
DEFAULT_MODEL=deepseek-v4-flash
OCR_MODEL=gpt-4o-mini

# ── Clerk auth (apps/web) ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── MCP server ────────────────────────────────────────────────────────
MCP_PORT=6710
MCP_URL=http://localhost:6710/mcp
# Shared bearer token between apps/web (client) and apps/mcp-server
MCP_SHARED_SECRET=

# ── File storage (local disk for v1) ──────────────────────────────────
UPLOAD_DIR=./uploads

# ── Policies ──────────────────────────────────────────────────────────
TRANSCRIPT_RETENTION_DAYS=365

# ── Scheduled jobs ────────────────────────────────────────────────────
# Secret for POST /api/jobs/* (Task Scheduler curls with x-job-secret header)
JOB_SECRET=
