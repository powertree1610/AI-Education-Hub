<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site: student-ai-web  (HttpPlatformHandler launches node with the Next.js standalone server)
  Generated by deploy\build-deploy.ps1 — edit the template in deploy\templates, not this copy.
  Secrets live in apps\web\.env (loaded by Next at startup); IIS supplies PORT here.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="{{NODE_EXE}}"
                  arguments="&quot;{{SITE_DIR}}\apps\web\server.js&quot;"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:10:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="{{SITE_DIR}}\logs\web">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <!-- Loopback only: nothing but IIS on this box may reach the node process.
             If the site answers 502.3 while node is running, remove this line. -->
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
    <!-- Let Next's own 404/500 pages through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
    <!-- Work uploads (images/PDF) are posted through IIS: allow up to 50 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <!-- Never let IIS re-compress the streamed chat responses (text/event-stream) -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
