<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site: student-ai-mcp  (HttpPlatformHandler launches node with the MCP bundle)
  Generated by deploy\build-deploy.ps1 — edit the template in deploy\templates, not this copy.
  Bind this site to 127.0.0.1 only. Secrets live in the .env next to index.js.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="{{NODE_EXE}}"
                  arguments="&quot;{{SITE_DIR}}\index.js&quot;"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:10:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="{{SITE_DIR}}\logs\mcp">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="MCP_PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
