# Copy to deploy\.env.web (gitignored) and fill in. deploy\build-deploy.ps1 places
# it in the web deploy folder. Do NOT set PORT or HOSTNAME here — IIS
# (HttpPlatformHandler) provides them via web.config.

# app_user role — pooled Neon endpoint
DATABASE_URL_APP=postgresql://app_user:...@ep-xxx-pooler.../neondb?sslmode=require

# Central AI API Server (licensed LLM gateway)
AI_API_SERVER_URL=http://115.187.22.224:6601
LICENSE_KEY=
DEFAULT_MODEL=deepseek-v4-flash
OCR_MODEL=gpt-4o-mini

# Self-hosted credentials auth — long random string (enables local auth mode)
AUTH_SECRET=

# MCP server = the student-ai-mcp IIS site (loopback only)
MCP_URL=http://127.0.0.1:3331/mcp
MCP_SHARED_SECRET=

# Absolute path on a backed-up volume
UPLOAD_DIR=C:\Web\student-ai-data\uploads

TRANSCRIPT_RETENTION_DAYS=365

# Secret for POST /api/jobs/* (Task Scheduler)
JOB_SECRET=
