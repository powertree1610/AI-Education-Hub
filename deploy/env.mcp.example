# Copy to deploy\.env.mcp (gitignored) and fill in. deploy\build-deploy.ps1 places
# it next to index.js in the MCP deploy folder. Do NOT set MCP_PORT here — IIS
# (HttpPlatformHandler) provides it via web.config.

# ai_agent role — pooled Neon endpoint
DATABASE_URL_AI=postgresql://ai_agent:...@ep-xxx-pooler.../neondb?sslmode=require

# Central AI API Server (licensed LLM gateway) — used for OCR of uploaded work
AI_API_SERVER_URL=http://115.187.22.224:6601
LICENSE_KEY=
DEFAULT_MODEL=deepseek-v4-flash
OCR_MODEL=gpt-4o-mini

# Must equal MCP_SHARED_SECRET in .env.web
MCP_SHARED_SECRET=

# Same absolute path as the web app (work files are read for OCR)
UPLOAD_DIR=C:\Web\student-ai-data\uploads
