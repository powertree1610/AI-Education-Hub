{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: all",
      "dependsOn": ["dev: web", "dev: mcp-server"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: web",
      "type": "shell",
      "command": "pnpm --filter @platform/web dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "dev: mcp-server",
      "type": "shell",
      "command": "pnpm --filter @platform/mcp-server dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "free dev ports (3000, 6710)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-NetTCPConnection -LocalPort 3000,6710 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }; Write-Output 'ports free'"
      ],
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}
